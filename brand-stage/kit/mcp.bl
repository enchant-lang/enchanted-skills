; mcp.bl — brand-stage's MCP tools over stdio, for a local harness.
;
;   claude mcp add brand-stage -- bl run -p ~/projects/enchanted-skills/brand-stage/kit/src \
;     ~/projects/enchanted-skills/brand-stage/kit/mcp.bl

(ns stage.stdio
  (:require [mcp.server :as mcp] [mcp.transport-stdio :as stdio] [stage.mcp :as m]))

(defserver endpoint
  (init [registry] (ok registry))
  (handle-call [:request request] [_from registry]
    (reply (mcp/request-response registry request)
           (if (= "initialize" (get request "method")) (assoc registry :lifecycle :legacy) registry))))
(def server (start endpoint (m/registry)))
(stdio/run server)
