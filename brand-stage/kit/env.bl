;; env.bl — brand-stage's kit: what `bl` reads about this folder. Run from here.
;;
;;   bl serve serve.bl -- /abs/path/stage.bl.org     the stage (PORT/HOST from env)
;;   bl run mcp.bl                                   the brand-model MCP tools over stdio
;;   bl run -p ~/projects/beam-lisp/optional/browser-port/bl shoot.bl -- URL OUT   browser QA
;;   bl --cold js build stage.client.main -p src --out web/out                     the client
;;
;; The dossier kit supplies dossier.org (the .bl.org reader) for decks.
{:name "brand-stage"
 :paths ["src" "../../bl-org-dossier/kit"]}
