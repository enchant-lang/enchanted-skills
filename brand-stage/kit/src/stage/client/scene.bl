(ns ^:js stage.client.scene
  "One three.js world behind every slide. Each 3D slide owns a group; the
   camera flies to that group's pose when the slide arrives. Labels are HTML
   elements pinned to 3D points (crisp, themeable, selectable) and projected
   every frame. Colours come from CSS tokens, so the night archive re-tints
   the scene without rebuilding it."
  (:require [stage.client.h :as h]))

(def state (atom {:groups {} :labels [] :ticks {} :active nil
                      :pose nil :target nil :t0 0 :themed []}))

(defn color [css] (js/THREE.Color. css))
(defn token [k fallback] (let [v (h/css-var k)] (if (= v "") fallback v)))

;; ── materials that follow the theme ────────────────────────────────────
(defn themed!
  "Register a material whose colour is the CSS token k (re-read on theme change)."
  [mat k]
  (swap! state update :themed conj [mat k])
  (.set (.-color mat) (color (token k "#000000")))
  mat)

(defn retint! []
  (doseq [[mat k] (:themed @state)] (.set (.-color mat) (color (token k "#000000"))))
  (when-let [r (:renderer @state)] (.setClearColor r (color (token "--paper" "#ffffff")) 0)))

(defn basic [k opts]
  (themed! (js/THREE.MeshBasicMaterial. (bl->js (merge {:transparent true :opacity 1} opts))) k))
(defn line-mat [k opts]
  (themed! (js/THREE.LineBasicMaterial. (bl->js (merge {:transparent true :opacity 1} opts))) k))
(defn dash-mat [k opts]
  (themed! (js/THREE.LineDashedMaterial. (bl->js (merge {:transparent true :opacity 1 :dashSize 0.12 :gapSize 0.09} opts))) k))
(defn hue-mat [css opts]
  (let [m (js/THREE.MeshBasicMaterial. (bl->js (merge {:transparent true :opacity 1} opts)))]
    (.set (.-color m) (color css)) m))

;; ── shapes ─────────────────────────────────────────────────────────────
(defn v3 [x y z] (js/THREE.Vector3. x y z))

(defn disc [r mat] (js/THREE.Mesh. (js/THREE.CircleGeometry. r 64) mat))
(defn ring [r w mat] (js/THREE.Mesh. (js/THREE.RingGeometry. (- r w) r 64) mat))
(defn ball [r mat] (js/THREE.Mesh. (js/THREE.SphereGeometry. r 32 16) mat))

(defn at! [obj x y z] (.set (.-position obj) x y z) obj)

(defn polyline
  "A line through points [[x y z] …]; dashed when mat is a dashed material."
  [pts mat]
  (let [geo (.setFromPoints (js/THREE.BufferGeometry.) (bl->js (mapv (fn [[x y z]] (v3 x y z)) pts)))
        l (js/THREE.Line. geo mat)]
    (.computeLineDistances l)
    l))

(defn curve-points
  "n points along a Catmull-Rom spline through pts."
  [pts n]
  (let [c (js/THREE.CatmullRomCurve3. (bl->js (mapv (fn [[x y z]] (v3 x y z)) pts)))]
    (mapv (fn [p] [(.-x p) (.-y p) (.-z p)]) (js->bl (.getPoints c n)))))

(defn tube [pts radius mat]
  (let [c (js/THREE.CatmullRomCurve3. (bl->js (mapv (fn [[x y z]] (v3 x y z)) pts)))]
    (js/THREE.Mesh. (js/THREE.TubeGeometry. c 200 radius 12 false) mat)))

(defn ribbon
  "A flat band between two polylines (same length): the area between what
   they feel and what we aim to leave them feeling."
  [top bottom mat]
  (let [n (count top)
        pos (js/Float32Array. (* n 2 3))
        idx (atom [])]
    (doseq [i (range n)]
      (let [[x1 y1 z1] (nth top i) [x2 y2 z2] (nth bottom i) o (* i 6)]
        (aset pos o x1) (aset pos (+ o 1) y1) (aset pos (+ o 2) z1)
        (aset pos (+ o 3) x2) (aset pos (+ o 4) y2) (aset pos (+ o 5) z2)
        (when (< i (- n 1))
          (let [a (* i 2) b (+ a 1) c (+ a 2) d (+ a 3)]
            (swap! idx into [a b c b d c])))))
    (let [geo (js/THREE.BufferGeometry.)]
      (.setAttribute geo "position" (js/THREE.BufferAttribute. pos 3))
      (.setIndex geo (bl->js @idx))
      (set! (.-side mat) js/THREE.DoubleSide)
      (js/THREE.Mesh. geo mat))))

(defn dust
  "A cloud of points. density-fn x → 0..1 decides how many grains stand at x.
   Returns the Points object; its grains drift in the tick."
  [x0 x1 n density-fn spread mat-k]
  (let [pts (atom [])]
    (loop [i 0]
      (when (< (count @pts) n)
        (let [x (+ x0 (* (js/Math.random) (- x1 x0)))]
          (when (< (js/Math.random) (density-fn x))
            (swap! pts conj [x (* spread (- (js/Math.random) 0.5) 1.6)
                             (* spread (- (js/Math.random) 0.5))]))
          (when (< i (* n 40)) (recur (+ i 1))))))
    (let [arr (js/Float32Array. (* 3 (count @pts)))]
      (doseq [[i [x y z]] (map-indexed (fn [i p] [i p]) @pts)]
        (aset arr (* i 3) x) (aset arr (+ 1 (* i 3)) y) (aset arr (+ 2 (* i 3)) z))
      (let [geo (js/THREE.BufferGeometry.)
            mat (themed! (js/THREE.PointsMaterial. #js {:size 0.035 :transparent true :opacity 0.55 :sizeAttenuation true}) mat-k)]
        (.setAttribute geo "position" (js/THREE.BufferAttribute. arr 3))
        (js/THREE.Points. geo mat)))))

;; ── labels ─────────────────────────────────────────────────────────────
(defn label!
  "Pin an HTML element (built from hiccup) to a 3D point of group gid."
  [gid [x y z] hiccup]
  (let [el (h/node hiccup)
        layer (h/$ "#labels")]
    (.add (.-classList el) "pin")
    (.appendChild layer el)
    (swap! state update :labels conj {:el el :v (v3 x y z) :gid gid})
    el))

(defn label-on!
  "Pin an HTML element to a moving object: it follows the object's world
   position, dy below (negative) or above it."
  [gid obj dy hiccup]
  (let [el (h/node hiccup)]
    (.add (.-classList el) "pin")
    (.appendChild (h/$ "#labels") el)
    (swap! state update :labels conj {:el el :obj obj :dy dy :v (v3 0 0 0) :gid gid})
    el))

(defn- place-labels! []
  (let [{:keys [camera active labels]} @state
        w (.-innerWidth js/window) hh (.-innerHeight js/window)]
    (doseq [{:keys [el v gid obj dy]} labels]
      (if (not= gid active)
        (set! (.-display (.-style el)) "none")
        (let [_ (when obj (.getWorldPosition obj v) (set! (.-y v) (+ (.-y v) dy)))
              p (.project (.clone v) camera)
              x (* (+ 1 (.-x p)) 0.5 w)
              y (* (- 1 (.-y p)) 0.5 hh)]
          (set! (.-display (.-style el)) (if (> (.-z p) 1) "none" ""))
          (set! (.-transform (.-style el)) (str "translate(" x "px," y "px)")))))))

;; ── groups and poses ───────────────────────────────────────────────────
(defn group!
  "The group for slide gid, with the camera pose {:eye [x y z] :look [x y z]}
   and an optional (tick t group) called every frame while it is shown."
  [gid pose tick]
  (let [g (js/THREE.Group.)]
    (set! (.-visible g) false)
    (.add (:scene @state) g)
    (swap! state assoc-in [:groups gid] {:group g :pose pose})
    (when tick (swap! state assoc-in [:ticks gid] tick))
    g))

(defn has?
  "True when gid's group exists — or when there is no world at all, so the
   builders skip and the deck still reads without WebGL."
  [gid]
  (or (nil? (:scene @state)) (contains? (:groups @state) gid)))

(defn- lerp [a b t] (+ a (* (- b a) t)))
(defn- ease [t] (let [t (max 0 (min 1 t))] (- 1 (js/Math.pow (- 1 t) 3))))

(defn show!
  "Make gid the visible group (nil hides the world) and fly the camera to its pose."
  [gid]
  (let [{:keys [groups pose camera]} @state]
    (doseq [[k {:keys [group]}] groups] (set! (.-visible group) (= k gid)))
    (set! (.-opacity (.-style (h/$ "#world"))) (if gid "1" "0"))
    (when-let [p (get-in groups [gid :pose])]
      (let [from {:eye [(.-x (.-position camera)) (.-y (.-position camera)) (.-z (.-position camera))]
                  :look (or (:look pose) (:look p))}]
        (swap! state assoc :active gid :from from :target p :t0 (h/now)
               :pose (if (h/reduced-motion?) p from))))
    (when (nil? gid) (swap! state assoc :active nil))))

(defn- frame [t]
  (let [{:keys [renderer scene camera active from target t0 ticks groups]} @state]
    (when (and target from)
      (let [k (if (h/reduced-motion?) 1 (ease (/ (- (h/now) t0) 1400)))
            e (mapv (fn [a b] (lerp a b k)) (:eye from) (:eye target))
            l (mapv (fn [a b] (lerp a b k)) (:look from) (:look target))]
        (.set (.-position camera) (nth e 0) (nth e 1) (nth e 2))
        (.lookAt camera (nth l 0) (nth l 1) (nth l 2))
        (swap! state assoc :pose {:eye e :look l})))
    (when-let [f (get ticks active)]
      (when-not (h/reduced-motion?)
        (try (f t (get-in groups [active :group]))
             (catch e
               ;; report once, then drop the tick: the scene holds still but labels keep tracking
               (.error js/console (str "scene tick " active ": " (ex-message e)))
               (swap! state update :ticks dissoc active)))))
    (.render renderer scene camera)
    (place-labels!)
    nil))

(defn- resize! []
  (let [{:keys [renderer camera]} @state
        w (.-innerWidth js/window) hh (.-innerHeight js/window)]
    (.setSize renderer w hh)
    (set! (.-aspect camera) (/ w hh))
    ;; compositions are made for 16:9; a narrower screen zooms out until they fit
    (set! (.-zoom camera) (min 1 (/ (/ w hh) 1.3)))
    (.updateProjectionMatrix camera)))

(defn init!
  "Create the renderer on canvas#world. Returns false when WebGL is missing,
   so the deck still reads (labels and 2D figures) without the world."
  []
  (let [canvas (h/$ "#world")]
    (try
      (let [renderer (js/THREE.WebGLRenderer. #js {:canvas canvas :antialias true :alpha true})
            scene (js/THREE.Scene.)
            camera (js/THREE.PerspectiveCamera. 38 1 0.1 200)]
        (.setPixelRatio renderer (min 2 (.-devicePixelRatio js/window)))
        (swap! state assoc :renderer renderer :scene scene :camera camera)
        (.set (.-position camera) 0 0 12)
        (resize!)
        (retint!)
        (h/on! js/window "resize" (fn [_] (resize!)))
        (.setAnimationLoop renderer (fn [t] (frame t)))
        true)
      (catch e false))))
