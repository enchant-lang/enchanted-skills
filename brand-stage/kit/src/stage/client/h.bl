(ns ^:js stage.client.h
  "Hiccup to DOM, for the stage's 2D figures. A vector [tag attrs? & kids]
   becomes an element; SVG tags get the SVG namespace; strings become text;
   nil and false vanish; seqs splice. Attribute :on is a map of event → fn.")

(def svg-ns "http://www.w3.org/2000/svg")
(def svg-tags #{"svg" "g" "path" "circle" "rect" "line" "polyline" "polygon" "text" "tspan" "defs" "pattern" "clipPath" "ellipse" "title" "marker" "use"})

(defn- tag-parts
  "\"div.a.b#id\" → [\"div\" \"a b\" \"id\"]"
  [s]
  (let [[base id] (let [i (.indexOf s "#")] (if (>= i 0) [(.slice s 0 i) (.slice s (+ i 1))] [s nil]))
        parts (js->bl (.split base "."))]
    [(first parts) (apply str (interpose " " (rest parts))) id]))

(declare node)

(defn- append-kids! [el kids svg?]
  (doseq [k kids]
    (cond (nil? k) nil
          (false? k) nil
          (vector? k) (.appendChild el (node k svg?))
          (seq? k) (append-kids! el k svg?)
          :else (.appendChild el (.createTextNode js/document (str k))))))

(defn node
  ([v] (node v false))
  ([v svg?]
   (if (not (vector? v))
     (.createTextNode js/document (str v))
     (let [[tag cls id] (tag-parts (name (first v)))
           svg? (or svg? (contains? svg-tags tag))
           el (if svg? (.createElementNS js/document svg-ns tag) (.createElement js/document tag))
           attrs (when (map? (second v)) (second v))
           kids (if attrs (drop 2 v) (rest v))]
       (when (not= cls "") (.setAttribute el "class" cls))
       (when id (.setAttribute el "id" id))
       (doseq [[k a] attrs]
         (cond (= k :on) (doseq [[ev f] a] (.addEventListener el (name ev) (fn [e] (f e) nil)))
               (= k :class) (when a (.setAttribute el "class" (str (if (= cls "") "" (str cls " ")) a)))
               (= k :style) (when a (.setAttribute el "style" a))
               (nil? a) nil
               (false? a) nil
               (true? a) (.setAttribute el (name k) "")
               :else (.setAttribute el (name k) (str a))))
       (append-kids! el kids svg?)
       el))))

(defn mount! [parent v]
  (set! (.-textContent parent) "")
  (let [el (node v)] (.appendChild parent el) el))

(defn $ [sel] (.querySelector js/document sel))
(defn $$ [root sel] (js->bl (js/Array.from (.querySelectorAll root sel))))
(defn on! [target ev f] (.addEventListener target ev (fn [e] (f e) nil)))
(defn css-var [k]
  (.trim (.getPropertyValue (js/getComputedStyle (.-documentElement js/document)) k)))
(defn now [] (.now js/performance))
(defn reduced-motion? [] (.-matches (.matchMedia js/window "(prefers-reduced-motion: reduce)")))
