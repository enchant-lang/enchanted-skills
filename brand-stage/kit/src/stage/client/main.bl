(ns ^:js stage.client.main
  "The stage: fetch the projected model, lay out one section per deck slide,
   move with keys/swipes/hash, open any entity as a CARI specimen sheet."
  (:require [stage.client.h :as h]
            [stage.client.scene :as w]
            [stage.client.slides :as sl]))

(declare close-sheet! lower-label)

(def ui (atom {:i 0 :data nil :overview false :world false}))

(defn- slides [] (get-in @ui [:data :deck :slides]))
(defn- coll-of [kind]
  (get {"step" :steps "persona" :personas "pillar" :pillars "fear" :fears "worry" :worries
        "gap" :gaps "stage" :stages "asset" :assets "phase" :phases "dimension" :dimensions
        "expression" :expressions} (name kind)))
(defn- find-entity [kind id]
  (first (filter (fn [x] (= id (:id x))) (get (:data @ui) (coll-of kind)))))

;; ── the specimen sheet ─────────────────────────────────────────────────
(defn- row [k v] (when (and v (not= v "")) [:div.srow [:span.sk k] [:span.sv v]]))
(defn- bar [label kids] (when (seq kids) [:details.ibar {:open true} [:summary (lower-label label)] [:div.ibody kids]]))
(defn- lower-label [s] (.toLowerCase (str s)))
(defn- basis [b]
  (when b [:span.basis {:class b}
           (case b "stated" "● stated in the source" "inferred" "◌ inferred — to confirm" "assumed" "◌ assumed — our estimate" b)]))
(defn- chip [kind id label] [:button.chip {:on (sl/opens kind id)} label])

(defn- sheet-body [kind e]
  (let [d (:data @ui)
        P (sl/by-id (:personas d)) L (sl/by-id (:pillars d)) S (into {} (map (fn [s] [(:n s) s]) (:steps d)))
        F (sl/by-id (:fears d))]
    (case (name kind)
      "persona"
      (list [:p.lead (:context e)]
            (row "age" (:age e)) (row "joins at" (str "step " (:enters e))) (row "« yours » means" (:yours e))
            (basis "assumed") [:p.note "placement on the people field (weight, fluency) is our estimate"]
            (bar "what they say to themselves" (for [q (:says e)] [:p.quote {:style (str "--hue:" (sl/hue e))} (str "« " q " »")]))
            (bar "what they are trying to solve" (for [q (:solves e)] [:p q]))
            (bar "what they fear about us" (for [q (:fears-us e)] [:p q]))
            (bar "how to explain it" [:p (:explain e)])
            (bar "the french line" [:p.brand-voice.fr (:pitch e)])
            (bar "worries they carry" (for [wv (:worries d) :when (some (fn [p] (= p (:id e))) (:personas wv))]
                                         (chip :worry (:id wv) (:text wv)))))
      "step"
      (list [:p.lead (str "« " (:head e) " »")]
            (row "where" (:place e)) (row "mood" (:mood e))
            [:div.srow [:span.sk "we leave"] [:span.sv.green (:feel e)]]
            [:p (:feel-line e)]
            (row "would lose them" (:lose e))
            (row "phase" (:phase e))
            (when (:note e) [:p.alert (:note e)])
            (row "doubt" (str (js/Math.round (* 100 (:doubt e))) " / 100")) (basis "assumed")
            (bar "who is here" (for [c (:presence d) :when (= (:step c) (:n e))]
                                 (let [p (get P (:persona c))]
                                   [:p {:class (str "pq " (:state c)) :style (str "--hue:" (sl/hue p))}
                                    [:b (:name p)] " " (:question c)])))
            (bar "worries answered here" (for [wv (:worries d) :when (some (fn [n] (= n (:n e))) (:steps wv))]
                                           (chip :worry (:id wv) (:text wv))))
            (bar "assets" (for [a (:assets d) :when (some (fn [n] (= n (:n e))) (:steps a))]
                            [:button.chip {:class (:status a) :on (sl/opens :asset (:id a))} (str (:title a) " · " (:status a))]))
            (bar "gaps here" (for [g (:gaps d) :when (= (:step g) (:n e))] (chip :gap (:id g) (:title g)))))
      "worry"
      (list [:p.lead (str "« " (:text e) " »")]
            (row "the answer has to show" (:proof e))
            (row "steps" (apply str (interpose ", " (:steps e))))
            (bar "who" (for [pid (:personas e)] (chip :persona pid (:name (get P pid)))))
            (bar "which « yours »" (if (:tone e) [:p.note "none — this is tone"]
                                       (for [lid (:pillars e)] (chip :pillar lid (:short (get L lid))))))
            (bar "fear underneath" (if (seq (:fears e))
                                     (list (for [fid (:fears e)] (chip :fear fid (:title (get F fid)))) (basis "inferred"))
                                     [:p.note "none of the three fears — a day-to-day worry"])))
      "pillar"
      (list [:p.lead (:line e)] (row "at dinner" (:metaphor e))
            (row "worries carried" (str (:worries e) " of " (count (:worries d))))
            (bar "worries" (for [wv (:worries d) :when (some (fn [l] (= l (:id e))) (:pillars wv))] (chip :worry (:id wv) (:text wv))))
            (bar "fears it answers" (list (for [f (:fears d) :when (some (fn [l] (= l (:id e))) (:pillars f))] (chip :fear (:id f) (:title f)))
                                         (basis "inferred"))))
      "fear"
      (list [:p.lead (:line e)] [:div.srow [:span.sk "answer"] [:span.sv.green (:answer e)]]
            (bar "carried by" (list (for [l (:pillars e)] (chip :pillar l (:short (get L l)))) (basis "inferred")))
            (bar "worries under it" (for [wv (:worries d) :when (some (fn [f] (= f (:id e))) (:fears wv))] (chip :worry (:id wv) (:text wv)))))
      "gap"
      (list [:p.lead (:line e)] (row "kind" (:kind-label e)) (row "weight" (str (:severity e) " / 3"))
            (when (:step e) [:div.srow [:span.sk "at"] [:span.sv (chip :step (:id (get S (:step e))) (str "step " (:step e)))]])
            (when (:persona e) [:div.srow [:span.sk "who"] [:span.sv (chip :persona (:persona e) (:name (get P (:persona e))))]])
            (row "evidence" (:evidence e))
            (row "next move" (:move e)))
      "stage"
      (list [:p.lead (:line e)] (row "track" (:track e)) (row "status" (:status e)) (row "date" (:date e)) (row "evidence" (:evidence e))
            (bar "assets" (for [a (:assets d) :when (= (:stage a) (:id e))]
                            [:button.chip {:class (:status a) :on (sl/opens :asset (:id a))} (:title a)])))
      "asset"
      (list (row "kind" (:kind e)) (row "status" (:status e)) (row "note" (:note e))
            (bar "used at" (for [n (:steps e)] (chip :step (:id (get S n)) (str "step " n " · " (:title (get S n)))))))
      "phase"
      (list [:p.lead (if (= "beyond" (:scope e)) "Beyond the booked meeting. The notebook stops before this phase; nothing is written for it yet." "Walked by the notebook.")]
            (bar "steps" (for [st (:steps d) :when (= (:phase st) (:id e))] (chip :step (:id st) (:title st)))))
      "dimension"
      (list [:p.lead (:question e)]
            (row "filled from" (or (:attr e) "nothing in the model yet")))
      "expression"
      (list [:p.lead.brand-voice (:text e)] (row "language" (:locale e)) [:p (:reason e)])
      (list (for [[k v] e] (row (name k) (str v)))))))

(defn- entity-title [kind e]
  (case (name kind)
    "persona" (:name e) "step" (:title e) "worry" "a worry" "pillar" (:short e) "fear" (:title e)
    "gap" (:title e) "stage" (:title e) "asset" (:title e) "phase" (:title e) "dimension" (:title e)
    "expression" (:text e) (str (:id e))))

(defn open-sheet! [kind id]
  (let [e (find-entity kind id)
        sheet (h/$ "#sheet")]
    (when e
      (h/mount! sheet
                [:div.sheet-in
                 [:div.slug [:span.mark] [:span.sname (.toLowerCase (str (entity-title kind e)))]
                  [:button.close {:aria-label "close" :on {:click (fn [_] (close-sheet!))}} "×"]]
                 [:i.namesake (str (name kind) (when (:fact-basis e) (str " · " (:fact-basis e))))]
                 [:div.sbody (sheet-body kind e)]])
      (.add (.-classList sheet) "open")
      (.setAttribute sheet "aria-hidden" "false"))))

(defn close-sheet! []
  (let [sheet (h/$ "#sheet")]
    (.remove (.-classList sheet) "open")
    (.setAttribute sheet "aria-hidden" "true")))

(defn- notes! [s]
  (h/mount! (h/$ "#sheet")
            [:div.sheet-in
             [:div.slug [:span.mark] [:span.sname (.toLowerCase (str (:title s)))]
              [:button.close {:aria-label "close" :on {:click (fn [_] (close-sheet!))}} "×"]]
             [:i.namesake (or (:namesake s) "speaker notes")]
             [:div.sbody (for [p (:body s)] [:p p])]])
  (.add (.-classList (h/$ "#sheet")) "open"))

;; ── slides and navigation ──────────────────────────────────────────────
(defn- slide-el [i] (h/$ (str "#slide-" i)))

(defn go! [i]
  (let [ss (slides) n (count ss) i (max 0 (min (- n 1) i))
        s (nth ss i)]
    (doseq [j (range n)] (.toggle (.-classList (slide-el j)) "on" (= j i)))
    (swap! ui assoc :i i)
    (when (:world @ui)
      (w/show! (when (contains? sl/world-layouts (:layout s)) (:layout s))))
    (set! (.-textContent (h/$ "#count")) (str (sl/fmt2 (+ i 1)) " / " (sl/fmt2 n)))
    (set! (.-width (.-style (h/$ "#progress"))) (str (* 100 (/ (+ i 1) n)) "%"))
    (.replaceState js/history nil "" (str "#" (+ i 1)))
    (.setAttribute (.-documentElement js/document) "data-layout" (:layout s))))

(defn- overview! [on?]
  (swap! ui assoc :overview on?)
  (.toggle (.-classList (.-body js/document)) "overview" on?))

(defn- build! [d]
  (let [deck (:deck d) ss (:slides deck) root (h/$ "#deck")
        d (assoc d :subtitle (:subtitle deck))]
    (set! (.-title js/document) (str (:title deck) " · brand stage"))
    (h/mount! root
              [:div.slides
               (for [[i s] (map-indexed (fn [i s] [i s]) ss)]
                 [:section.slide {:id (str "slide-" i) :data-layout (:layout s)
                                  :on {:click (fn [_] (when (:overview @ui) (overview! false) (go! i)))}}
                  [:header.slide-head
                   [:button.ibar-head {:on {:click (fn [e] (.stopPropagation e) (notes! s))}}
                    [:span.mark] [:span.kick (.toLowerCase (str (:kicker s)))] [:span.more "notes ▾"]]
                   [:span.tile-n.mono (sl/fmt2 (+ i 1))]]
                  [:p.tile-say (:say s)]
                  [:div.stage-area (sl/render d s)]
                  (when (:namesake s) [:footer.namesake [:i (:namesake s)]])])])))

(defn- key! [e]
  (let [k (.-key e) i (:i @ui)]
    (cond
      (contains? #{"ArrowRight" "PageDown" " "} k) (do (.preventDefault e) (go! (+ i 1)))
      (contains? #{"ArrowLeft" "PageUp"} k) (do (.preventDefault e) (go! (- i 1)))
      (= k "Home") (go! 0)
      (= k "End") (go! (- (count (slides)) 1))
      (= k "o") (overview! (not (:overview @ui)))
      (= k "n") (notes! (nth (slides) i))
      (= k "t") (let [root (.-documentElement js/document)
                      dark? (= "dark" (.getAttribute root "data-theme"))]
                  (.setAttribute root "data-theme" (if dark? "light" "dark"))
                  (w/retint!))
      (= k "Escape") (do (close-sheet!) (overview! false))
      :else nil)))

(defn- swipe! []
  (let [x0 (atom nil)]
    (h/on! js/window "touchstart" (fn [e] (reset! x0 (.-clientX (aget (.-touches e) 0)))))
    (h/on! js/window "touchend"
           (fn [e] (when-let [a @x0]
                     (let [dx (- (.-clientX (aget (.-changedTouches e) 0)) a)]
                       (when (and (> (js/Math.abs dx) 60) (not (:overview @ui)))
                         (go! (+ (:i @ui) (if (< dx 0) 1 -1)))))
                     (reset! x0 nil))))))

(defn- start! [d]
  (swap! ui assoc :data d :world (w/init!))
  (when-not (:world @ui) (.add (.-classList (.-body js/document)) "no-webgl"))
  (when (= "dark" (.getAttribute (.-documentElement js/document) "data-theme")) (w/retint!))
  (reset! sl/opener open-sheet!)
  (build! d)
  (h/on! js/window "keydown" key!)
  (swipe!)
  (h/on! (h/$ "#prev") "click" (fn [_] (go! (- (:i @ui) 1))))
  (h/on! (h/$ "#next") "click" (fn [_] (go! (+ (:i @ui) 1))))
  (h/on! (h/$ "#grid") "click" (fn [_] (overview! (not (:overview @ui)))))
  (h/on! (h/$ "#theme") "click" (fn [_] (key! #js {:key "t" :preventDefault (fn [] nil)})))
  (let [hash (js/parseInt (.slice (.-hash js/location) 1))]
    (go! (if (js/isNaN hash) 0 (- hash 1))))
  (set! (.-stageReady js/globalThis) true))

(-> (js/fetch "api/stage.json")
    (.then (fn [r] (.json r)))
    (.then (fn [j] (start! (js->bl j :keywordize-keys true)) nil))
    (.catch (fn [err]
              (.error js/console err)
              (set! (.-textContent (h/$ "#deck")) (str "The stage could not load its model: " err))
              nil)))
