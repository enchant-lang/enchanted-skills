(ns stage.model
  "The brand model as an in-memory datom database, spun up from a folder of
   EDN files (index.edn names the schema and the tx files, in load order).

   The EDN is written for people: every entity carries a :*/id keyword and
   refers to others by lookup ref [:persona/id :karim]. datom wants tempids,
   so `load!` gives every entity a negative tempid, rewrites each lookup ref
   to the tempid it names, and transacts the whole model in one transaction.
   After that, everything — projections for the stage, coverage, gaps — is a
   Datalog query or a pull against that db."
  (:require [datom] [clojure.edn :as edn]))

;; ── schema ─────────────────────────────────────────────────────────────
(defn- id-attr? [k] (and (= "id" (name k)) (not= "db" (namespace k))))

(defn schema-defs
  "datom attribute definitions from the readable schema map. An attribute
   with no declared type is a keyword when it is an id, else a term (any
   value: strings, numbers, booleans, keywords)."
  [schema]
  (vec (for [[k spec] (sort-by (fn [[k _]] (str k)) schema)]
         (merge {:db/ident k
                 :db/valueType (or (:db/valueType spec) (if (id-attr? k) :db.type/keyword :db.type/term))
                 :db/cardinality (or (:db/cardinality spec) :db.cardinality/one)}
                (when (:db/unique spec) {:db/unique (:db/unique spec)})
                (when (:doc spec) {:db/doc (:doc spec)})))))

(defn ref-attrs [schema] (set (for [[k spec] schema :when (= :db.type/ref (:db/valueType spec))] k)))
(defn many-attrs [schema] (set (for [[k spec] schema :when (= :db.cardinality/many (:db/cardinality spec))] k)))

;; ── loading ────────────────────────────────────────────────────────────
(defn- read-edn [path] (edn/read-string (File/read! path)))

(defn identity-of
  "[:persona/id :karim] for an entity map, from its one :*/id attribute."
  [e]
  (first (for [[k v] e :when (id-attr? k)] [k v])))

(defn read-model
  "{:schema {...} :entities [...] :files [...]} from a model folder."
  [dir]
  (let [index (read-edn (str dir "/index.edn"))
        schema (read-edn (str dir "/" (:schema index)))
        files (:tx index)]
    {:name (:name index) :dir dir :schema schema :files files
     :entities (vec (mapcat (fn [f] (read-edn (str dir "/" f))) files))}))

(defn problems
  "What would make the model unloadable or misleading: unknown attributes,
   duplicate identities, lookup refs to nothing."
  [{:keys [schema entities]}]
  (let [ids (map identity-of entities)
        known (set ids)
        refs (ref-attrs schema)
        dup (for [[k n] (frequencies ids) :when (> n 1)] {:problem :duplicate :id k})
        noid (for [e entities :when (nil? (identity-of e))] {:problem :no-identity :entity e})
        unknown (for [e entities [k _] e :when (not (contains? schema k))] {:problem :unknown-attribute :attr k :id (identity-of e)})
        dangling (for [e entities [k v] e :when (contains? refs k)
                       r (if (and (vector? v) (vector? (first v))) v [v])
                       :when (not (contains? known r))]
                   {:problem :dangling-ref :attr k :ref r :id (identity-of e)})]
    (vec (concat dup noid unknown dangling))))

(defn tx-data
  "The model's entities as one datom transaction: tempids for identities,
   lookup refs rewritten to those tempids."
  [{:keys [schema entities]}]
  (let [refs (ref-attrs schema)
        many (many-attrs schema)
        tids (into {} (map-indexed (fn [i e] [(identity-of e) (- (+ i 1))]) entities))
        resolve (fn [r] (or (get tids r) (throw (ex-info "unknown lookup ref" {:ref r}))))]
    (vec (for [e entities]
           (into {:db/id (get tids (identity-of e))}
                 (for [[k v] e]
                   [k (cond (and (contains? refs k) (contains? many k)) (mapv resolve v)
                            (contains? refs k) (resolve v)
                            :else v)]))))))

(defn load!
  "Spin up the db: {:conn :db :model :report}. Throws on model problems."
  [dir]
  (let [m (read-model dir)
        ps (problems m)]
    (when (seq ps) (throw (ex-info (str "model problems: " (pr-str (take 5 ps))) {:problems ps})))
    (let [conn (datom/connect (schema-defs (:schema m)))
          report (datom/transact! conn (tx-data m))]
      {:conn conn :db (datom/db conn) :model m :datoms (count (:tx-datoms report))})))

;; ── reading back ───────────────────────────────────────────────────────
(def kinds
  "Entity kind → its identity attribute, in the order the stage lists them."
  [[:brand :brand/id] [:expression :expression/id] [:pillar :pillar/id] [:fear :fear/id]
   [:persona :persona/id] [:line :line/id] [:phase :phase/id] [:step :step/id]
   [:principle :principle/id] [:presence :presence/id] [:worry :worry/id]
   [:dimension :dimension/id] [:stage :stage/id] [:asset :asset/id]])

(defn eids [db id-attr]
  (datom/q [:find '[?e ...] :where ['?e id-attr '_]] db))

(defn ident-of
  "eid → [:persona/id :karim]"
  [db eid]
  (let [e (datom/entity db eid)]
    (first (for [[k v] e :when (and (keyword? k) (id-attr? k))] [k v]))))

(defn pull-kind
  "Every entity of a kind as a plain map: namespaces dropped, refs turned
   into the id (a string) of the entity they point at."
  [db schema id-attr]
  (let [ref? (ref-attrs schema)
        refs (fn [v] (name (second (ident-of db (if (map? v) (:db/id v) v)))))]
    (vec (for [eid (eids db id-attr)]
           (let [e (datom/pull db '[*] eid)]
             (into {:eid eid}
                   (for [[k v] e :when (not= k :db/id)]
                     (let [short (keyword (name k))
                           short (if (= "fact" (namespace k)) (keyword (str "fact-" (name k))) short)]
                       [short (cond (and (contains? ref? k) (sequential? v)) (mapv refs v)
                                    (contains? ref? k) (refs v)
                                    (keyword? v) (name v)
                                    :else v)]))))))))

(defn count-by
  "{id-string count} — how many `from` entities point at each `to` entity through attr."
  [db attr to-id]
  (into {} (for [[id n] (datom/q [:find '?id '(count ?x) :where ['?x attr '?t] ['?t to-id '?id]] db)]
             [(name id) n])))
