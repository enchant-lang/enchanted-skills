(ns stage.deck
  "A deck is a .bl.org file: #+title / #+subtitle / #+model in the header,
   one top-level heading per slide. The heading's property drawer picks the
   figure (:LAYOUT:), the index-bar kicker (:KICKER:), the few words shown at
   rest (:SAY:) and the italic source line (:NAMESAKE:). Paragraphs and list
   items under the heading are the speaker notes, opened from the kicker bar."
  (:require [dossier.org :as o]))

(def layouts #{"title" "words" "fears" "pillars" "people" "journey" "presence" "worries" "framework" "process" "gaps"})

(defn- props [node] (into {} (for [[k v] (:pairs node)] [(keyword (.toLowerCase (str k))) v])))

(defn read-deck
  "{:title :subtitle :model :slides [{:id :layout :kicker :title :say :namesake :body}]}"
  [text]
  (let [doc (o/read-doc text)
        meta (:meta doc)
        slides (loop [ns (:nodes doc) cur nil out []]
                 (if (empty? ns)
                   (if cur (conj out cur) out)
                   (let [n (first ns)]
                     (cond
                       (and (= :heading (:t n)) (= 1 (:level n)))
                       (recur (rest ns) {:title (:title n) :body [] :line (:line n)} (if cur (conj out cur) out))
                       (nil? cur) (recur (rest ns) cur out)
                       (= :props (:t n))
                       (recur (rest ns) (merge cur (props n)) out)
                       (= :para (:t n)) (recur (rest ns) (update cur :body conj (:text n)) out)
                       (= :list (:t n)) (recur (rest ns) (update cur :body into (map (fn [i] (if (map? i) (or (:text i) (str i)) (str i))) (:items n))) out)
                       :else (recur (rest ns) cur out)))))]
    {:title (get meta "title" (get meta :title "Brand stage"))
     :subtitle (get meta "subtitle" (get meta :subtitle ""))
     :model (get meta "model" (get meta :model "model"))
     :slides (vec (map-indexed (fn [i s] (assoc s :id (str "slide-" (+ i 1)) :n (+ i 1)
                                                :layout (or (:layout s) "caption")))
                               slides))}))

(defn problems [deck]
  (vec (for [s (:slides deck) :when (not (contains? layouts (:layout s)))]
         {:slide (:n s) :problem :unknown-layout :layout (:layout s)})))
