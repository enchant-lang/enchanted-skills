; shoot.bl — walk a brand stage in a real browser and keep what it showed.
;
;   bl run -p ~/projects/beam-lisp/optional/browser-port/bl shoot.bl -- URL OUTDIR [light|dark]
;
; For each viewport (a 16:9 wall, a laptop, a phone) and each slide: press →,
; wait for the camera to land, screenshot, and record what a reviewer would
; otherwise have to eyeball — page errors, horizontal overflow, content that
; spills out of its slide, labels pinned off-screen, whether WebGL started.
; Writes OUTDIR/<viewport>-<nn>.png, OUTDIR/report.edn and OUTDIR/index.html
; (a contact sheet). Exits 1 when any slide has an error or an overflow.

(ns stage.shoot (:require [browser.page :as page] [bl.json :as json]))

(def args (BeamLisp/argv))
(def url (or (first args) (throw (ex-info "usage: shoot.bl -- URL OUTDIR [light|dark]" {}))))
(def out (Path/expand (or (second args) "~/.cache/stage-shots")))
(def theme (or (nth args 2 nil) "light"))
(def home (System/get_env "HOME"))
(def rt (str home "/.local/share/bl-browser/runtime-wayland/bin/"))
(def scratch (str (System/get_env "HOME") "/.cache/stage-shoot-" (erlang/unique_integer (list :positive))))
(File/mkdir_p! out) (File/mkdir_p! scratch)

;; The port launches Chromium with --disable-gpu, and current Chromium then
;; refuses its software WebGL; the stage's scenes would never draw. A wrapper
;; adds SwiftShader back for this run only (QA of a trusted local page).
(def chromium
  (let [w (str scratch "/chromium")]
    (File/write! w (str "#!/bin/sh\nexec " rt "chromium --enable-unsafe-swiftshader --use-angle=swiftshader --ignore-gpu-blocklist \"$@\"\n"))
    (System/cmd "chmod" (list "+x" w))
    w))

(def viewports
  [{:name "wall" :width 1920 :height 1080 :scale 1 :mobile false}
   {:name "laptop" :width 1440 :height 900 :scale 1 :mobile false}
   {:name "phone" :width 390 :height 844 :scale 2 :mobile true}])

(def probe
  "(() => { const s = document.querySelector('.slide.on'); const a = s && s.querySelector('.stage-area');
     const pins = [...document.querySelectorAll('#labels .pin')].filter(p => p.style.display !== 'none');
     const off = pins.filter(p => { const r = p.getBoundingClientRect(); return r.right < 0 || r.left > innerWidth || r.bottom < 0 || r.top > innerHeight; }).length;
     const spill = a ? [...a.querySelectorAll('*')].filter(e => { const r = e.getBoundingClientRect(); return r.width > 0 && (r.right > innerWidth + 2 || r.left < -2); }).length : 0;
     return JSON.stringify({ layout: s && s.dataset.layout, errors: window.__stageErrors || [],
       hscroll: document.documentElement.scrollWidth > innerWidth + 1,
       clipped: a ? a.scrollHeight > a.clientHeight + 4 : false, spill: spill,
       pins: pins.length, pinsOff: off, webgl: !document.body.classList.contains('no-webgl') }); })()")

(defn- shoot-viewport [p vp]
  (page/cdp! p "Emulation.setDeviceMetricsOverride"
             {"width" (:width vp) "height" (:height vp) "deviceScaleFactor" (:scale vp) "mobile" (:mobile vp)})
  (page/navigate! p (str url "?v=" (:name vp) "#1"))
  (try (page/wait! p "window.stageReady === true" 60000)
       (catch e
         (page/screenshot! p (str out "/not-ready-" (:name vp) ".png"))
         (println "NOT READY" (:name vp) (page/evaluate! p "JSON.stringify({errors: window.__stageErrors, deck: (document.querySelector('#deck')||{}).textContent})"))
         (throw e)))
  (when (= theme "dark") (page/key! p "t"))
  (let [n (page/evaluate! p "document.querySelectorAll('.slide').length")]
    (vec (for [i (range n)]
           (do (when (> i 0) (page/key! p "ArrowRight"))
               (page/evaluate! p "new Promise(r => setTimeout(r, 1700))")
               (let [file (str (:name vp) "-" (if (< i 9) "0" "") (+ i 1) ".png")
                     r (json/decode (page/evaluate! p probe))]
                 (page/screenshot! p (str out "/" file))
                 (assoc r "file" file "slide" (+ i 1) "viewport" (:name vp))))))))

(defn- bad? [r] (or (seq (get r "errors")) (get r "hscroll") (> (get r "spill" 0) 0)))

(def p (page/open! {:executable (or (System/get_env "BL_BROWSER_PORT")
                                    (str home "/projects/beam-lisp/optional/browser-port/target/release/bl-browser-port"))
                    :width 1920 :height 1080
                    :launch {"profile" (str scratch "/profile") "runtime" (str scratch "/runtime")
                             "chromium" chromium "compositor" (str rt "sway") "vnc" (str rt "wayvnc")
                             "width" 1920 "height" 1080}}))

(def results
  (try (vec (mapcat (fn [vp] (shoot-viewport p vp)) viewports))
       (finally (page/close! p))))

(File/write! (str out "/report.edn") (pr-str results))
(File/write! (str out "/index.html")
  (str "<!doctype html><meta charset=utf-8><title>stage shots</title>"
       "<style>body{font:14px system-ui;margin:24px;background:#fff}figure{display:inline-block;margin:8px;vertical-align:top}"
       "img{max-width:420px;max-height:300px;border:1px solid #cdcdcd}figcaption{font:12px monospace}.bad{color:#900}</style>"
       (apply str (for [r results]
                    (str "<figure><img src='" (get r "file") "'><figcaption class='" (if (bad? r) "bad" "") "'>"
                         (get r "viewport") " " (get r "slide") " · " (get r "layout")
                         (when (bad? r) (str " · " (pr-str (select-keys r ["errors" "hscroll" "spill"]))))
                         "</figcaption></figure>")))))

(doseq [r results]
  (println (get r "viewport") (get r "slide") (get r "layout")
           (if (bad? r) (str "BAD " (pr-str (select-keys r ["errors" "hscroll" "spill" "clipped"]))) "ok")
           (str "pins " (get r "pins") "/" (get r "pinsOff") " off" (when (get r "clipped") " · clipped"))))
(println "shots:" out)
(when (some bad? results) (System/halt 1))
