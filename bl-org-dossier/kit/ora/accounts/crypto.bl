(ns ora.accounts.crypto (:require [auth] [auth.identity :as identity] [clojure.edn :as edn] [bl.json :as json]))
(defn random [] (auth/magic-token))
(defn digest [value] (auth/token-hash value))
(defn fingerprint [key value]
 (Base/encode16 (crypto/mac :hmac :sha256 (crypto/hash :sha256 (:private key)) value) (list (tuple :case :lower))))
(defn id [prefix] (str prefix (subs (digest (random)) 0 24)))
(defn key! [path]
 (when-not (File/regular? path)
  (let [key (auth/keypair)]
   (File/write! path (pr-str {:public (Base/encode64 (:public key)) :private (Base/encode64 (:private key))}))
   (File/chmod! path 384)))
 (let [value (edn/read-string (File/read! path))]
  {:public (Base/decode64! (:public value)) :private (Base/decode64! (:private value))}))
(defn seal-result [key value]
 (let [iv (crypto/strong_rand_bytes 12) raw (json/encode value)
       result (crypto/crypto_one_time_aead :aes_256_gcm (crypto/hash :sha256 (:private key)) iv raw "ora.accounts.receipt/1" 16 true)]
  {:iv (Base/encode64 iv) :bytes (Base/encode64 (elem result 0)) :tag (Base/encode64 (elem result 1))}))
(defn open-result [key value]
 (json/decode (crypto/crypto_one_time_aead :aes_256_gcm (crypto/hash :sha256 (:private key))
   (Base/decode64! (:iv value)) (Base/decode64! (:bytes value)) "ora.accounts.receipt/1" (Base/decode64! (:tag value)) false)))
(defn issue
 ([key subject application audience kind expiry] (issue key subject application audience kind expiry []))
 ([key subject application audience kind expiry rights]
  (auth/encode-base64
   (auth/seal (identity/issue key {:subject subject :application application :kind kind :audience audience :expires-at expiry :rights rights})))))
(defn verify [key raw audience]
 (try (identity/verify-token (:public key) (auth/decode-base64 raw) audience (auth/revocation-oracle (fn [_] false))) (catch _ nil)))
