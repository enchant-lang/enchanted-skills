(ns codec-run (:require [dossier.org :as o] [dossier.page :as pg] [dossier.attrs :as at] [dossier.codec :as c] [bl.json :as json]))
(def rows (atom []))
(def headers (atom {:same 0 :diff 0 :examples []}))
(doseq [f (remove blank? (split (File/read! (System/get_env "CORPUS")) "\n"))]
  (let [t0 (erlang/monotonic_time :millisecond) text (File/read! f) lines (vec (split text "\n")) doc (o/read-doc text)]
    (pg/doc-h doc)
    (doseq [nd (:nodes doc)]
      (when (= :block (:t nd))
        (let [l (nth lines (:line nd)) l' (at/header-line l (:lang nd) (at/read-attrs l))]
          (if (= l l') (swap! headers update :same inc)
            (swap! headers (fn [h] (-> h (update :diff inc) (update :examples #(if (< (count %) 12) (conj % [l l']) %))))))))
      (when (and (integer? (:line nd)) (integer? (:to nd)) (not= :props (:t nd)))
        (let [m (try (c/measure-node lines nd true) (catch e {:error (str e)}))]
          (swap! rows conj (merge {"f" f "t" (name (:t nd)) "lang" (or (:lang nd) (name (:t nd)))}
                                  {"runs" (:runs m) "aligned" (:aligned m) "chars" (:chars m) "aligned_chars" (:aligned-chars m)
                                   "edits" (into {} (for [[k v] (:edits m)] [(name k) v])) "error" (:error m)})))))
    (println "codec" (count (:nodes doc)) (- (erlang/monotonic_time :millisecond) t0) "ms" f)))
(File/write! (System/get_env "OUT") (json/encode {"rows" @rows "headers" {"same" (:same @headers) "diff" (:diff @headers) "examples" (:examples @headers)}}))
