(ns live-edit-test
  (:require [dossier.org :as o] [dossier.page :as pg] [dossier.storage :as storage] [dossier.live :as live] [live.hiccup :as h]))

(def text "#+title: T\n\n* One\n\nPara one\nwraps.\n\n- a\n- b\n\n#+begin_ask :id q1 :title \"Why?\"\nBecause.\n#+end_ask\n")

(defn- html [tree] (apply str (map h/hiccup->html (if (seq? tree) tree [tree]))))

(deftest rendered-blocks-name-their-exact-source-lines
  (let [out (html (pg/doc-h (o/read-doc text)))]
    (is (includes? out "data-src=\"2:3\"") "heading")
    (is (includes? out "data-src=\"4:6\"") "paragraph over two lines")
    (is (includes? out "data-src=\"7:9\"") "list")
    (is (includes? out "data-src=\"10:13\"") "semantic block, begin to end")))

(deftest the-page-loads-its-in-place-editor-only-when-a-host-offers-it
  (let [doc (o/read-doc text)
        live (h/hiccup->html (pg/page-h doc "" "" {:config "{\"rev\":\"0\",\"editable\":true}"}))
        plain (h/hiccup->html (pg/page-h doc "" ""))
        locked (h/hiccup->html (pg/page-h (assoc-in doc [:meta :locked] true) "" "" {:config "{}"}))]
    (is (includes? live "data-live-doc="))
    (is (includes? live "_live/client.js"))
    (is (includes? live "_live/client.css"))
    (is (not (includes? plain "_live/")))
    (is (not (includes? locked "_live/")) "a client reading never edits")))

(deftest storage-writes-through-an-installed-host-writer
  (let [path (str "/tmp/dossier-writer-" (erlang/unique_integer (list :positive)) ".bl.org")
        seen (atom [])]
    (File/write! path "a\n")
    (try
      (storage/install-writer! (fn [p transform]
                                 (if (= p path) (do (swap! seen conj p) (:value (transform "hosted\n"))) :pass)))
      (is (= :hosted (storage/update! path (fn [t] {:text (str t "x") :value :hosted}))))
      (is (= [path] @seen))
      (is (= "a\n" (File/read! path)) "the host owns the write")
      (finally (storage/install-writer! nil) (File/rm! path)))))

(deftest a-host-can-remap-or-close-a-blocks-source-lines
  (let [doc (o/read-doc text)
        nodes (:nodes doc)
        doc (assoc doc :nodes (mapv (fn [n] (cond (= 4 (:line n)) (assoc n :src "40:42")
                                                  (= 7 (:line n)) (assoc n :src nil) :else n)) nodes))
        out (html (pg/doc-h doc))]
    (is (includes? out "data-src=\"40:42\"") "an included part maps to its own lines")
    (is (not (includes? out "data-src=\"4:6\"")))
    (is (not (includes? out "data-src=\"7:9\"")) "a block with no file line stays closed")
    (is (includes? out "data-src=\"10:13\""))))

(deftest one-vm-edits-several-files-through-one-live-store
  (let [dir (str "/tmp/dossier-live-" (erlang/unique_integer (list :positive)))
        a (str dir "/a.bl.org") b (str dir "/b.bl.org") other (str dir "/c.bl.org")]
    (File/mkdir_p! dir)
    (File/write! a "* A\n") (File/write! b "* B\n") (File/write! other "* C\n")
    (try
      (is (live/open! [a]) "Omega is on the kit's path")
      (is (live/open! [b]) "a second file joins the same store")
      (is (= "* A\n" (live/source a)))
      (is (= :ok (storage/update! b (fn [t] {:text (str t "\nnew\n") :value :ok}))))
      (is (= "* B\n\nnew\n" (File/read! b)) "the store publishes to disk")
      (is (= "* B\n\nnew\n" (live/source b)))
      (is (= :plain (storage/update! other (fn [t] {:text (str t "x") :value :plain}))) "other files keep the file writer")
      (is (= "* C\nx" (File/read! other)))
      (is (nil? (live/route nil other)) "no routes for a file that is not live")
      (finally (storage/install-writer! nil) (File/rm_rf dir)))))
