;; The same gate covers entries, assets, HEAD and byte ranges.
(ns dossier.share.read (:require [web] [bl.json :as json] [dossier.share.model :as model] [ora.accounts.client :as accounts]))
(defn read-json [path] (try (json/decode (File/read! path)) (catch _ nil)))
(defn unavailable [c] (web/text c 404 "Ce lien n'est plus disponible."))
(defn router [root host original]
 (let [c (-> original (web/resp-header "cache-control" "private, no-store")
            (web/resp-header "referrer-policy" "no-referrer") (web/resp-header "x-robots-tag" "noindex, nofollow, noarchive")
            (web/resp-header "content-security-policy" "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'")
            (web/resp-header "x-content-type-options" "nosniff"))
       path (web/path c)]
  (try
   (or
    (when host (accounts/routes host c (fn [request result] (web/redirect request (accounts/safe-next (get result "return"))))))
    (cond
     (= path "/health") (web/json c {:ok true :accounts (boolean host)})
     (= path "/account") (if host (web/redirect c (str (get-in host [:config :accounts-origin]) "/account")) (unavailable c))
     (not (contains? #{"get" "head"} (web/method c))) (web/text c 405 "Lecture seule.")
     :else
     (if-let [match (Regex/run #"^/(s|p)/([A-Za-z0-9_-]{1,100})/(?:r/([a-f0-9]{64})/(.*))?$" path)]
      (let [mode (nth match 1) key (nth match 2) rev (nth match 3 "") tail (nth match 4 "")
            _ (when (and (= mode "s") (not (model/token? key))) (model/refuse "Invalid link"))
            local (when (= mode "s") (read-json (str root "/grants/" (model/digest key) ".json")))
            id (if (= mode "p") key (get local "id"))
            access (when (and host id) (accounts/call! host "access" {"id" id "mode" (if (= mode "p") "id" "capability")
                          "tokenHash" (when (= mode "s") (model/digest key)) "revision" rev "token" (web/req-cookie c "ora-client")}))
            grant (if host (get access "publication") local)
            admitted (if host (get access "allowed") (and (= mode "s") local (not (get local "revoked")) (= "link" (get local "visibility" "link"))))]
       (cond
        (and host (get access "login") (or (blank? tail) (= tail "index.html")))
        (accounts/begin! host c (str "/p/" id "/" (when-not (blank? rev) (str "r/" rev "/" tail))) {})
        (not admitted) (unavailable c)
        (or (get grant "revoked") (not (model/hex? (get grant "revision")))) (unavailable c)
        (blank? rev) (web/text (web/resp-header c "location" (str "/" mode "/" key "/r/" (get grant "revision") "/")) 307 "")
        (not (contains? (set (get grant "revisions")) rev)) (unavailable c)
        :else
        (let [directory (str root "/objects/" rev) manifest (read-json (str directory "/manifest.json"))
              file (get-in manifest ["routes" (model/route-key tail (web/query c))])]
         (if-not file (unavailable c)
          (let [opts (Plug.Static/init (list (tuple :at "/") (tuple :from (str directory "/public"))
                       (tuple :gzip false) (tuple :cache_control_for_etags "private, no-store")))
                response (Plug.Static/call (Map/put c :path_info (String/split (get file "file") "/")) opts)]
           (if (= :unset (:state response)) (unavailable c) response))))))
      (unavailable c))))
   (catch error (web/text c 503 "Le service d'accès est momentanément indisponible.")))))
