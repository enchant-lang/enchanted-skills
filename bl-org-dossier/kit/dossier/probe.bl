; dossier/probe.bl — where does each piece of source land on the page?
;
; PROTOTYPE (prototype/rich-edit). Zero annotations: a block's renderer is a
; pure function of its node, so swap ONE source piece (a header attribute, or
; one delimited segment of one body line) for a unique marker, render the node
; again through the same `node-h` the page uses, and look for the marker in
; the hiccup:
;
;   :text        it shows as text            → edit in place, at that path
;   :attr        only inside an attribute    → popover field (href, src …)
;   :transformed shows altered (case, slug)  → popover field
;   :structural  output changed, no marker   → a control (enum / toggle)
;   :ignored     output identical            → not drawn; settings only
;   :error       the renderer refused it     → constrained value
;
; The paths it returns are what the editor's projection marks with data-f.
(ns dossier.probe
  (:require [dossier.org :as o] [dossier.page :as pg] [dossier.attrs :as at]))

(defn marker [n] (str "zqx" n "q"))

(defn- tag? [x] (and (vector? x) (keyword? (first x))))

(defn- found
  "[{:where :text|:attr :path [...] :attr k}] for every place `m` occurs."
  [h m]
  (let [out (atom [])]
    (letfn [(walk [x path]
              (cond
                (string? x) (when (includes? x m) (swap! out conj {:where :text :path path}))
                (tag? x) (let [a (when (map? (second x)) (second x))
                               kids (if a (drop 2 x) (rest x))]
                           (doseq [[k v] a :when (and (string? v) (includes? v m))]
                             (swap! out conj {:where :attr :path path :attr k}))
                           (doseq [[i c] (map-indexed (fn [i c] [i c]) kids)] (walk c (conj path i))))
                (or (seq? x) (vector? x)) (doseq [[i c] (map-indexed (fn [i c] [i c]) x)] (walk c (conj path i)))
                :else nil))]
      (walk h []))
    @out))

(defn- loose? [h m]
  (let [s (lower-case (pr-str h))] (or (includes? s (lower-case m)) (includes? s (upper-case m)))))

(defn classify
  "Render `nd'` (nd with one piece replaced by marker `m`) against baseline
   `h0`; the class and the places it landed."
  [h0 nd' m]
  (try
    (let [h (pg/node-h nd') hits (found h m)]
      (cond
        (some #(= :text (:where %)) hits) {:class :text :hits (filterv #(= :text (:where %)) hits)}
        (seq hits) {:class :attr :hits hits}
        (loose? h m) {:class :transformed}
        (= h h0) {:class :ignored}
        :else {:class :structural}))
    (catch e {:class :error :error (str e)})))

(defn- with-attr [nd k v]
  (let [pairs (mapv (fn [[pk pv]] (if (= pk k) [pk v] [pk pv])) (:pairs nd))]
    (assoc nd :pairs pairs :attrs (at/attr-map pairs))))

(def ^:private delim (Regex/compile! "\\s*(?:\\||->|→|=>|:|,|;)\\s*" "u"))

(defn segments
  "The editable-looking segments of a body line: text between delimiters,
   each [from to] as byte offsets in the line."
  [line]
  (let [word (Regex/compile! "\\p{L}|\\d" "u")]
    (loop [ps (Regex/split delim line (list (tuple :include_captures true))) at 0 out [] gap? false]
      (if-let [p (first ps)]
        (let [t (trim p) lead (- (erlang/byte_size p) (erlang/byte_size (String/trim_leading p)))
              seg? (and (not gap?) (not= "" t) (some? (Regex/run word t)))]
          (recur (rest ps) (+ at (erlang/byte_size p))
                 (if seg? (conj out [(+ at lead) (+ at lead (erlang/byte_size t))]) out)
                 (not gap?)))
        out))))

(defn- splice-bytes [s from to v] (str (erlang/binary_part s 0 from) v (erlang/binary_part s to (- (erlang/byte_size s) to))))

(defn probe-block
  "Every attribute and body segment of block `nd`, classified."
  [nd]
  (let [h0 (pg/node-h nd) n (atom 0) next! (fn [] (marker (swap! n inc)))]
    {:lang (:lang nd)
     :attrs (vec (for [[k v] (:pairs nd) :when (and (string? v) (not= "true" v))]
                   (let [m (next!)] (assoc (classify h0 (with-attr nd k m) m) :key k))))
     :body (vec (for [[i line] (map-indexed (fn [i l] [i l]) (:body nd))
                      [from to] (segments line)]
                  (let [m (next!) body' (assoc (:body nd) i (splice-bytes line from to m))]
                    (assoc (classify h0 (assoc nd :body body') m) :line i :from from :to to))))}))

(defn probe-prose
  "Prose nodes: does the text flow through as text?"
  [nd]
  (let [h0 (pg/node-h nd) m (marker 0)]
    (case (:t nd)
      :para {:t :para :r (classify h0 (assoc nd :text (str (:text nd) " " m)) m)}
      :heading {:t :heading :r (classify h0 (assoc nd :title (str (:title nd) " " m)) m)}
      :list {:t :list :r (classify h0 (update-in nd [:items 0] (fn [it] (if (map? it) (update it :text #(str % " " m)) (str it " " m)))) m)}
      :table {:t :table :r (classify h0 (assoc-in nd [:rows 0 0] m) m)}
      {:t (:t nd) :r {:class :skipped}})))

(defn probe-doc
  "Probe every node of `text`."
  [text]
  (let [doc (o/read-doc text)]
    (pg/doc-h doc) ; the render context (language, notebook) doc-h installs
    (vec (for [nd (:nodes doc)]
           (if (= :block (:t nd)) (assoc (probe-block nd) :t :block) (probe-prose nd))))))
