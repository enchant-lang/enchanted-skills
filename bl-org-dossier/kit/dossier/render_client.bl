; dossier/render_client.bl — the kit's renderer, in the browser.
;
; PROTOTYPE (prototype/rich-edit). The same dossier.org + dossier.page the
; server uses, compiled by `bl js build` (see js-overlay/ for the platform
; twin). The editor re-renders the edited block locally, as you type, through
; exactly the function that drew it on the server.
(ns ^:js dossier.render-client
  (:require [dossier.org :as o] [dossier.page :as pg] [live.hiccup :as h]))

(defn doc-html
  "Org text -> the document body HTML, as the server's GET /doc."
  [text]
  (apply str (map h/hiccup->html (pg/doc-h (o/read-doc text)))))

(defn node-html
  "One node (as read-doc returns it) -> its HTML."
  [nd]
  (h/hiccup->html (pg/node-h nd)))

(defn ^:export render [text] (bl->js (doc-html (js->bl text))))

(defn ^:export time-blocks
  "Per-node render cost over the whole document: [count p50 p95 max] in ms.
   This is the editor's real per-keystroke cost (it re-renders one block)."
  [text]
  (let [doc (o/read-doc (js->bl text))
        _ (pg/doc-h doc)
        ms (sort (for [nd (:nodes doc)]
                   (let [t0 (.now js/performance)] (node-html nd) (- (.now js/performance) t0))))
        n (count ms) at (fn [q] (nth ms (min (dec n) (int (* q n)))))]
    (bl->js [n (at 0.5) (at 0.95) (last ms)])))

(defn ^:export time-render
  "Render `text` n times; ms per render (the editor's per-keystroke budget)."
  [text n]
  (let [t (js->bl text) t0 (.now js/performance)]
    (dotimes [_ n] (doc-html t))
    (/ (- (.now js/performance) t0) n)))
