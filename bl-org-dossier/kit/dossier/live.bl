;; In-place editing for any host that serves .bl.org files with this kit.
;; Omega's omega.live-doc owns the editing: one watched shared buffer per file,
;; so answers, comments, roster notes and in-place edits share one revision
;; stream and external writes (Emacs, an agent) reach every open page. Omega
;; is found on the path (the kit's env.bl), else at DOSSIER_OMEGA_SRC or
;; ~/projects/omega/src. Without it every function here is inert and the host
;; serves read-only, as before.
;;
;;   (live/open! [file ...])            at the host's top level, once
;;   (live/route conn file opts)        first in the handler; nil off its prefix
;;   (page/page-h doc css js (live/page file opts))  the same for every reader,
;;                                      so the page may be cached
;;   (live/source file)                 the text the store holds
;;
;; opts: :prefix — the routes' absolute path, default "/_live"; a page served
;; at /x/ uses "/x/_live" (the client resolves `_live/` against the page URL).
;; :owner — the Tailscale login that edits, default DOSSIER_OWNER.
(ns dossier.live
  (:require [web] [dossier.storage :as storage] [dossier.answer :as ans] [dossier.catalogue :as catalogue]
            [bl.json :as json]))

(def ^:private kit-dir
  (or (System/get_env "DOSSIER_KIT_DIR") (Path/dirname (Path/dirname (BeamLisp.Loader/source_path "dossier.live")))))

(def ^:private inplace-dir
  "The compiled in-place editor (build-inplace-client.sh): Beam Lisp → ES
   modules, the kit's own renderer included."
  (str kit-dir "/inplace-client"))

(defn- load-api []
  (try
    (let [src (or (System/get_env "DOSSIER_OMEGA_SRC") (Path/expand "~/projects/omega/src"))]
      (when (and (nil? (try (BeamLisp.Loader/source_path "omega.live-doc.host") (catch _ nil))) (File/dir? src))
        (BeamLisp.Env/add_search_path src))
      (BeamLisp.Loader/ensure_loaded "omega.live-doc.store")
      (BeamLisp.Loader/ensure_loaded "omega.live-doc.host")
      (into {} (for [[k ns n] [[:open! "omega.live-doc.store" "open!"] [:current "omega.live-doc.store" "current"]
                               [:update! "omega.live-doc.store" "update!"] [:handler "omega.live-doc.host" "handler"]
                               [:owner-editor "omega.live-doc.host" "owner-editor"] [:page-config "omega.live-doc.host" "page-config"]]]
                 [k (BeamLisp.Env/fetch! ns n)])))
    (catch error
      (println (str "dossier: live editing unavailable (" (ex-message error) "); serving read-only refresh"))
      nil)))

(defn- state [] (persistent_term/get :dossier.live/state nil))
(defn- live-file [path]
  (let [s (state) p (Path/expand path)] (when (and (:store s) (contains? (:files s) p)) p)))

(defn open!
  "Open this VM's live store for `files`; later calls add files. Call it at the
   host's top level: the buffer server lives as long as its caller. True when
   live editing is available."
  [files]
  (let [s (or (state) (let [api (load-api)] {:api api :store (when api ((:open! api) {})) :files #{}}))
        s (assoc s :files (into (:files s) (map (fn [f] (Path/expand f)) files)))]
    (persistent_term/put :dossier.live/state s)
    (when (:store s)
      (storage/install-writer!
        (fn [path transform]
          (let [st (state)]
            (if (contains? (:files st) path) ((:update! (:api st)) (:store st) path transform "dossier") :pass)))))
    (boolean (:store s))))

(defn available? [] (boolean (:store (state))))

(defn source
  "The file's text as the store holds it (the file itself when not live)."
  [path]
  (if-let [p (live-file path)] (:text ((:current (:api (state))) (:store (state)) p)) (File/read! path)))

(defn- options [p opts]
  {:file p :prefix (or (:prefix opts) "/_live")
   :inplace (when (File/regular? (str inplace-dir "/ns/dossier.editor-client.mjs")) "inplace/ns/dossier.editor-client.mjs")
   :editor? ((:owner-editor (:api (state))) (or (:owner opts) (System/get_env "DOSSIER_OWNER")))
   :client (fn [conn] (or (ans/handle (web/req-header conn "tailscale-user-login") (System/get_env "DOSSIER_HANDLE")) "owner"))})

(defn- kit-route
  "The kit's own routes under the prefix, for editors: the in-place editor's
   modules and the catalogue of what it can insert."
  [conn p o]
  (let [prefix (:prefix o) path (web/path conn)]
    (when (and (= "get" (web/method conn)) (starts-with? path (str prefix "/")))
      (let [op (subs path (inc (count prefix)))]
        (cond
          (not (or (starts-with? op "inplace/") (= op "catalogue"))) nil
          (not ((:editor? o) conn)) (web/json conn 403 {:error "Only this document's owner edits it here."})
          (= op "catalogue")
          (web/json (web/resp-header conn "cache-control" "no-store")
                    (catalogue/build p (source p) (catalogue/static-blocks [(str kit-dir "/inplace-blocks.json")
                                                                           (str (Path/dirname p) "/inplace-blocks.json")])))
          :else
          (let [rel (subs op 8) file (str inplace-dir "/" rel)]
            (if (and (not (includes? rel "..")) (ends-with? rel ".mjs") (File/regular? file))
              (web/bytes (web/resp-header conn "cache-control" "no-cache") "text/javascript; charset=utf-8" (File/read! file))
              (web/text conn 404 "not found"))))))))

(defn route
  "The /_live/* routes for one file, or nil (any other path, or not live)."
  ([conn path] (route conn path {}))
  ([conn path opts]
   (when-let [p (live-file path)]
     (let [o (options p opts)]
       (or (kit-route conn p o)
           (((:handler (:api (state))) (:store (state)) o) conn))))))

(defn page
  "page-h's `live` argument, or nil when the file is not live. It names the
   revision being rendered and the routes, never the reader: the client asks
   the routes whether its reader edits, so hosts may cache the page."
  ([path] (page path {}))
  ([path opts]
   (when-let [p (live-file path)]
     {:config ((:page-config (:api (state))) (:store (state)) p (options p opts))})))
