; dossier/portable.bl — the host primitives a renderer needs, named once.
;
; Rendering must run on the BEAM (server pages) and in the browser (the live
; editor re-renders a block as you type). The JS build resolves this namespace
; from `js-overlay/`, whose twin implements the same functions over JS
; globals. Everything here is pure except `env`, which is nil in a browser.
;
; PROTOTYPE (prototype/rich-edit): these exist because Enchant's JS leaf table
; lacks erlang/round, binary_to_integer, phash2, Regex/split … Once those
; leaves ship upstream, callers go back to the plain calls and this file goes.
(ns dossier.portable)

(defn round [x] (erlang/round x))
(defn ceil [x] (erlang/ceil x))
(defn floor [x] (erlang/floor x))
(defn pow [x y] (math/pow x y))
(defn log10 [x] (math/log10 x))
(defn parse-int ([s] (erlang/binary_to_integer s)) ([s base] (erlang/binary_to_integer s base)))
(defn parse-float [s] (erlang/binary_to_float s))
(defn hash [x] (erlang/phash2 x))
(defn days [y m d] (calendar/date_to_gregorian_days y m d))
(defn re-split ([re s] (Regex/split re s)) ([re s opts] (Regex/split re s opts)))
(defn url-encode [s] (URI/encode_www_form s))
(defn trim-trailing [s suffix] (String/trim_trailing s suffix))
(defn env [k] (System/get_env k))
(defn file? [p] (File/regular? p))
(defn read-file [p] (File/read! p))
(defn path-join [a b] (Path/join a b))
(defn path-expand [p] (Path/expand p))
(defn path-dirname [p] (Path/dirname p))
(defn registry-get [k] (Application/get_env :beam_lisp k))
(defn registry-put! [k v] (Application/put_env :beam_lisp k v))
