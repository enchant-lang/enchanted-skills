; dossier/editor_client.bl — the kit's plug for Omega's in-place editor.
;
; Compiled to ES modules with Omega's omega.live-doc.inplace by
; build-inplace-client.sh and loaded by the live-doc client for editors only.
; It hands the engine the kit's OWN reader and renderer (the functions the
; server drew the page with), so every passage on the page is editable where
; it stands, for every block type, present and future, with nothing declared
; by the blocks.
(ns ^:js dossier.editor-client
  (:require [dossier.org :as o] [dossier.page :as pg] [dossier.attrs :as at]
            [omega.live-doc.inplace :as inplace]))

(defn- read-text [text] (o/read-doc text {:review? false}))

(defn- reparse
  "One node's source read on its own, placed back at `line`; nil when the
   text no longer reads as exactly one node."
  [src line]
  (let [nodes (vec (remove #(= :props (:t %)) (:nodes (read-text src))))]
    (when (= 1 (count nodes))
      (-> (first nodes) (update :line + line) (update :to + line)))))

(def ^:private reader-keys #{"answer" "note" "at" "by"})

(defn- settings
  "A block's parameters: those its attributes carry and those its renderer
   reads (the catalogue's analysis), each with the control its use asks for."
  [nd catalogue]
  (when (= :block (:t nd))
    (let [entry (first (filter #(= (:lang nd) (get % "lang")) (get catalogue "blocks")))
          params (get entry "params" {})
          ks (distinct (concat (map first (:pairs nd)) (sort (keys params))))]
      (vec (for [k ks :when (not (contains? reader-keys k))
                 :let [p (get params k {}) v (get (:attrs nd) (keyword k))]]
             {:key k :label k :kind (get p "kind" "text") :values (get p "values" []) :value v
              :suggest (get p "suggest" []) :placeholder (get p "default")})))))

(defn- set-param
  "The edit setting attribute `k` of block `nd` to `v` (nil removes it):
   only that attribute's bytes on the header line change."
  [lines nd k v]
  (let [line (nth lines (:line nd))]
    {:from (:line nd) :before line :text (at/set-attr line k (when-not (blank? v) v))}))

(inplace/start!
  {:read read-text
   :prepare (fn [doc] (pg/doc-h doc) nil)
   :render pg/node-h
   :reparse reparse
   :escape at/escape-at
   :settings settings
   :set set-param
   :refreshed "dossier:refreshed"})
