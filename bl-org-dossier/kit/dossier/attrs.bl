; dossier/attrs.bl — the header line of a semantic block, read and written.
;
;   #+begin_ask :id q1 :title "Who drives?" :options "A|B" :answer B
;
; Attributes are an ORDERED vector of [key value] pairs so a write-back
; keeps the author's order and only touches the keys it owns. A key with no
; value is a flag ("true"). Pure; no IO.

(ns dossier.attrs)

(def ^:private attr-re
  (Regex/compile! ":([A-Za-z][\\w-]*)(?:\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|[^\\s:\"]\\S*))?"))

(defn- unquote-value [v]
  (cond
    (nil? v) "true"
    (starts-with? v "\"") (-> (subs v 1 (dec (count v)))
                              (String/replace "\\\"" "\"")
                              (String/replace "\\\\" "\\"))
    :else v))

(defn header-lang
  "The block kind of a `#+begin_X …` line, lowercased, or nil."
  [line]
  (let [m (Regex/run (Regex/compile! "^\\s*#\\+begin_([A-Za-z][\\w-]*)" "i") line)]
    (when m (lower-case (second m)))))

(defn read-attrs
  "[[key value] …] from a block header line, in source order."
  [line]
  (let [rest-of (or (second (Regex/run (Regex/compile! "^\\s*#\\+begin_\\S+(.*)$" "i") line)) "")]
    (vec (for [m (Regex/scan attr-re rest-of)]
           [(nth m 1) (unquote-value (when (> (count m) 2) (nth m 2)))]))))

(defn attr-map
  "The attributes as a map of keyword → string (last write wins)."
  [pairs]
  (into {} (for [[k v] pairs] [(keyword k) v])))

(defn- quote-value [v]
  (if (or (= "" v) (some? (Regex/run (Regex/compile! "[\\s\":]") v)))
    (str "\"" (-> v (String/replace "\\" "\\\\") (String/replace "\"" "\\\"")) "\"")
    v))

(defn write-attrs
  "The attribute part of a header line for `pairs`."
  [pairs]
  (join " " (for [[k v] pairs] (if (= "true" v) (str ":" k) (str ":" k " " (quote-value v))))))

(defn header-line
  "A header line for block `lang` with `pairs`, keeping the indentation of
   `original`."
  [original lang pairs]
  (let [indent (or (second (Regex/run (Regex/compile! "^(\\s*)") original)) "")
        a (write-attrs pairs)]
    (str indent "#+begin_" lang (if (blank? a) "" (str " " a)))))

(defn patch-line
  "`line` with each key of `changes` (string → string-or-nil) removed and,
   when non-nil, re-appended at the end. Every other byte of the line, the
   author's quoting and order included, is kept as written."
  [line changes]
  (let [stripped (reduce (fn [l k]
                           (String/replace l (Regex/compile! (str "\\s+:" k "(?:\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^\\s:\"]\\S*))?(?=\\s|$)")) ""))
                         line (sort (keys changes)))
        added (write-attrs (for [k ["answer" "note" "at" "by"] :when (some? (get changes k))] [k (get changes k)]))]
    (if (blank? added) stripped (str stripped " " added))))

(defn set-attr
  "`line` with attribute `k` (a string) set to `v` IN PLACE: an existing key
   keeps its position and only its value's bytes change; a new key is
   appended; nil removes it. Every other byte stays as the author wrote it."
  [line k v]
  (let [re (Regex/compile! (str "(\\s+):" k "(?:\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"|[^\\s:\"]\\S*))?(?=\\s|$)"))
        m (Regex/run re line (list (tuple :return :index)))]
    (cond
      (and (nil? m) (nil? v)) line
      (nil? m) (str line " " (write-attrs [[k v]]))
      :else (let [[start len] (let [t (first m)] [(erlang/element 1 t) (erlang/element 2 t)])
                  head (erlang/binary_part line 0 start)
                  tail (erlang/binary_part line (+ start len) (- (erlang/byte_size line) start len))
                  lead (let [t (second m)] (erlang/binary_part line (erlang/element 1 t) (erlang/element 2 t)))]
              (if (nil? v) (str head tail) (str head lead (write-attrs [[k v]]) tail))))))

(defn escape-at
  "How `text` must be spelled to replace bytes [from,to) of block source `src`
   (omega.projection's :escape). On the `#+begin_` header: inside a quoted
   value, escape \\ and \"; an unquoted value that now needs quotes gets them.
   Elsewhere the text is the text."
  [src from to text]
  (let [nl (or (let [h (binary/match src "\n")] (when (not= :nomatch h) (erlang/element 1 h))) (erlang/byte_size src))]
    (if-not (and (some? (header-lang src)) (< to (inc nl)) (> from 0))
      text
      (let [prev (erlang/binary_part src (dec from) 1)
            next (if (< to (erlang/byte_size src)) (erlang/binary_part src to 1) "")]
        (cond
          (and (= "\"" prev) (= "\"" next)) (-> text (String/replace "\\" "\\\\") (String/replace "\"" "\\\""))
          (some? (Regex/run (Regex/compile! "[\\s\":]") text)) (quote-value text)
          :else text)))))
